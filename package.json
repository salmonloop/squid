{
  "name": "squid-desktop-assistant",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun run src/squid-app.ts",
    "dev": "bun run src/main.ts",
    "history:delete": "bun run src/history-delete.ts",
    "ui:smoke": "bun run src/ui-smoke.ts",
    "test": "bun test",
    "watch:desktop": "bun run src/watch-desktop.ts",
    "watch:files": "bun run src/watch-files.ts",
    "watch:screen": "bun run src/watch-screen.ts",
    "eval:agent": "bun run eval/eval-agent.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "shell-quote": "^1.12.0",
    "typebox": "1.3.36",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/shell-quote": "^1.7.5",
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  }
}
