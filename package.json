{
  "name": "squid-desktop-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/main.ts",
    "evaluate": "bun run src/evaluate.ts",
    "gate:pi": "bun run src/gate-pi.ts",
    "ledger:report": "bun run src/ledger-report.ts",
    "test": "bun test",
    "watch:files": "bun run src/watch-files.ts",
    "watch:screen": "bun run src/watch-screen.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "shell-quote": "^1.10.0",
    "typebox": "1.3.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/shell-quote": "^1.7.5",
    "bun-types": "1.3.11",
    "typescript": "7.0.2"
  }
}
