{
  "name": "squid-desktop-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/main.ts",
    "evaluate": "bun run src/evaluate.ts",
    "gate:pi": "bun run src/gate-pi.ts",
    "test": "bun test",
    "watch:files": "bun run src/watch-files.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.15"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "bun-types": "1.3.11",
    "typescript": "7.0.2"
  }
}
