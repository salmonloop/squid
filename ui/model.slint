// The two row shapes the wire delivers, and the only structs the panel holds.
//
// Both stay flat strings on purpose. Everything here arrives from the brain: the
// panel holds no list of setting names, no notion of which key belongs to which
// capability, and no idea which ones need a restart. That is what keeps this a
// form renderer rather than a second copy of the brain's schema — see
// docs/panel-protocol.md.

// One source-catalog row. `state` stays the string the brain sent —
// "running" | "stopped" | "unsupported" — rather than a bool, so a capability
// this run cannot start is a third answer instead of an unchecked box that looks
// like a choice the user made.
export struct SourceRow {
    id: string,
    label: string,
    state: string,
    // The newest diagnostic a running source has recorded, when it has one —
    // the sentence separating "watching" from "running but blind". Empty means
    // the wire had nothing to say: absent and null both map here.
    detail: string,
}

export struct SettingRow {
    id: string,
    label: string,
    // "text" | "int" | "enum" | "secret". Only `secret` changes the editor, and
    // only into a masked one; the brain validates every kind either way.
    kind: string,
    value: string,
    // "now" | "restart", shown as a marker so a value that will not take effect
    // until the brain restarts does not look like it already has.
    applies: string,
    // An environment variable is shadowing the file. Disclosed rather than
    // hidden: without it, a saved value that visibly does not apply looks like a
    // bug in the save.
    overridden: bool,
    // ";"-joined enum choices, rendered as a hint. Kept joined because the wire
    // is flat here, and splitting it would be parser work in a file with no
    // tests of its own.
    values: string,
    // The user-facing capability this setting belongs to, named by the brain's
    // schema. The panel groups by this string and never by an id it recognises,
    // which is what lets a new setting land in the right place with no change
    // here.
    group: string,
    // One plain sentence saying what the setting does. A label alone cannot
    // explain a retention window or a poll interval to someone who has not read
    // the source.
    description: string,
    // Whether a credential could be read here. The value itself is structurally
    // absent from every dump, so without this an empty box is the only thing a
    // saved key can look like — indistinguishable from never having set one.
    // False is the weaker half of that pair on purpose: it says the brain found
    // nothing it could read, which a store it may not open answers too. The
    // form must not turn it back into a claim that the user never set a key.
    secret-present: bool,
}

// One LLM request log entry for the debug viewer. Every field is a flat
// scalar — no nesting, no arrays — because it rides the same wire and the
// same hand parser as everything else. Default-zero integers mean "not
// reported yet" (a pending request has no duration), not "measured as zero".
export struct LlmLogRow {
    id: int,
    requested-at: string,
    responded-at: string,
    model: string,
    message-count: int,
    prompt-chars: int,
    http-status: int,
    duration-ms: int,
    // "pending" | "ok" | "error". Kept as the string the brain sent, like
    // every other enum the panel renders — so this side does not need a list
    // of outcomes to go stale against the brain's.
    outcome: string,
    error: string,
    // Bounded, scrubbed excerpt of the request content, shown in the details
    // dialog. Empty when the wire had none (a legacy brain, or a request with no
    // messages); the dialog renders empty as "no preview" rather than a blank.
    preview: string,
}
