import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SourceRow, SettingRow } from "model.slint";
import { StatusSummary } from "status.slint";
import { SourceCard } from "source-card.slint";
import { SettingEditor } from "settings.slint";
import { ConfirmationCard, DeferredNotice } from "confirmation.slint";

// Re-exported for the generated Rust bindings, which build these rows.
export { SourceRow, SettingRow }

// The tray lives in its own file and is re-exported here because `build.rs`
// compiles this one document: a component the root file does not export is not
// generated, and Rust would have nothing to construct. It is a *top-level*
// component, not an element inside the window — the icon has no window of its own.
export { SquidTray } from "tray.slint";

// A section heading. More space above than below, so a heading belongs to what
// follows it rather than floating between two groups.
component Heading inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 700;
}

// One label/value line in the evidence block.
component EvidenceRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: Theme.gap;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 13px;
        width: Theme.label-column;
        vertical-alignment: top;
    }
    Text {
        // Never a bare dash: naming the state is shorter to understand than a
        // punctuation mark the reader has to decode. But it names only what this
        // window can vouch for. "Nothing seen yet" used to sit here, and it is a
        // claim — that Squid looked and found nothing — which is false in every
        // state that empties this field for another reason: the capability that
        // feeds the row is switched off or unsupported, the session has not been
        // reached at all, or an episode boundary reset the projection. The row
        // cannot tell those apart, and it must not guess: which capability owns
        // which row is the brain's schema, and the panel deliberately holds none
        // of it. So the empty state reports the panel's own position — there is
        // nothing here to show — and leaves why to the cards above, which say it
        // per capability in their own words.
        text: root.value == "" ? "Nothing to show" : root.value;
        color: root.value == "" ? Theme.text-muted : Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// Squid's resident control panel.
//
// The old shape was one flat list of six sections named after this repository's
// own modules — WORLD, LAST AGENT TURN, CAPTURE, SERVICE, SOURCES, SETTINGS —
// with twenty-two settings rows always on screen. That is a directory of the
// source tree, and nobody arrives with that question. A person arrives with
// three: is it watching, did it see anything, and does it need me.
//
// So the order here is fixed and it is not negotiable by content: state first,
// any decision it is blocked on second, evidence third, the senses fourth, and
// configuration only ever inside the sense that owns it. There is no Advanced
// page, tab, or switch, and no catch-all group — an advanced control is advanced
// relative to one capability, so it lives behind that capability's own door.
export component PanelWindow inherits Window {
    in property <string> updated-at;
    in property <string> last-event;
    in property <string> application;
    in property <string> window-title;
    in property <string> gate;
    in property <int> selection-length: -1;
    in property <string> recent-actions;
    in property <int> episode-events: -1;
    in property <string> agent-status;
    in property <string> agent-text;
    in property <string> agent-at;
    // A turn is in flight right now, from the brain's own turn edges. The
    // answer to "is it alive", one heartbeat wide.
    in property <bool> agent-thinking;
    callback pause();
    callback resume();
    in property <string> agent-state;
    in property <bool> supervised;
    in property <string> service-state;
    in property <string> service-detail;
    // Whether a connection this window once held has since dropped. Set from the
    // transport, never from the wire — it is the panel's fact about itself. False
    // before the first connection ever stands up, because never having reached a
    // session is a different state from having lost one.
    in property <bool> link-lost;
    callback restart-service();
    callback start-service();
    in property <[SourceRow]> sources;
    callback toggle-source(string, bool);
    in property <[SettingRow]> settings;
    // The rows belonging to whichever group is open, filtered in Rust. Slint has
    // no way to take a subset of a model, and rendering all of them with the
    // non-matching ones hidden would leave their layout space behind.
    in property <[SettingRow]> group-settings;
    // The distinct setting groups that belong to no single sense, in dump order,
    // with any group a source card already owns removed. Built in Rust from the
    // two dumps rather than derived here: hardcoding the list would put the
    // brain's schema in this file — the one thing the wire's `group` field
    // exists to avoid.
    in property <[string]> setting-groups;
    callback save-setting(string, string);
    callback refresh();
    in property <string> status;
    in property <bool> prompt-pending;
    in property <string> prompt-kind;
    in property <string> prompt-summary;
    in property <string> prompt-expires-at;
    in property <string> prompt-why;
    in property <string> prompt-deny-consequence;
    callback approve();
    callback decline();

    // Which capability's settings are open, by group name. Empty means none, and
    // that is the resting state: configuration is never the first thing on
    // screen. Rust owns the value because it also owns the filtered rows — a
    // group opened here without them would render an empty door.
    in-out property <string> open-group;
    callback select-group(string);
    // A decision the person set aside. Local to the window on purpose — the
    // request is still live on the brain's side, and the engine's own deadline
    // still decides it. Deferring changes what this surface shows, never what
    // was answered.
    property <bool> deferred: false;

    // Counted in Rust rather than tracked here: the session refuses to stop the
    // last running observer, so each card needs to know whether it is that one.
    // Reading it from the catalog keeps the panel from holding a second opinion
    // about which sources are up.
    in property <int> running-sources: 0;

    // The status line's own headline, published so the tray can use it.
    //
    // Read from the component that computes it rather than recomputed: the state
    // machine in `status.slint` is deliberately the only place that decides what
    // Squid is doing, and a tooltip with its own opinion would be the second
    // projection this panel exists not to have. The consequence sentence is not
    // published — nothing outside the card needs it, and a property nobody reads
    // is a claim that something does.
    out property <string> status-title: status.title;

    title: "Squid";
    always-on-top: false;
    preferred-width: 640px;
    preferred-height: 780px;
    min-width: 480px;
    // A minimum height, because the old window had none: shrinking it clipped
    // the confirmation, the one surface with a deadline and consequences.
    min-height: 420px;
    background: Theme.canvas;
    default-font-size: 13px;

    VerticalLayout {
        padding: Theme.gap-loose;
        spacing: Theme.gap;

        HorizontalLayout {
            spacing: Theme.gap;
            Text {
                text: "Squid";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                text: "Refresh";
                accessible-description: "Ask the session for its current settings and sources.";
                clicked => { root.refresh(); }
            }
        }

        // State, always. Never scrolls out of reach, never waits behind content.
        status := StatusSummary {
            agent-state: root.agent-state;
            service-state: root.service-state;
            gate: root.gate;
            updated-at: root.updated-at;
            detail: root.service-detail;
            decision-pending: root.prompt-pending;
            link-lost: root.link-lost;
            thinking: root.agent-thinking;
            // The header's "Watching" is a claim about observers, so it reads the
            // catalog rather than inferring from a timestamp. `sources.length` is
            // computed here instead of handing the model across the boundary:
            // whether the catalog arrived is a scalar, and the rows themselves are
            // no business of a status line.
            running-sources: root.running-sources;
            sources-known: root.sources.length > 0;
        }

        // The decision, second, above everything else — and above the scroll
        // region, so it cannot be pushed off the bottom by a long settings list.
        // This is the defect a real smoke run caught: the confirmation used to
        // sit last inside the scroll view, below twenty-two settings rows, while
        // the header cheerfully said "Squid is ready".
        if root.prompt-pending && !root.deferred: ConfirmationCard {
            kind: root.prompt-kind;
            summary: root.prompt-summary;
            expires-at: root.prompt-expires-at;
            why: root.prompt-why;
            deny-consequence: root.prompt-deny-consequence;
            allow => { root.deferred = false; root.approve(); }
            decline => { root.deferred = false; root.decline(); }
            defer => { root.deferred = true; }
        }

        if root.prompt-pending && root.deferred: DeferredNotice {
            reopen => { root.deferred = false; }
        }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Theme.gap-loose;

                // What Squid can see, and the only place its configuration
                // lives. Cards first because "is it watching my browser" is a
                // question people actually have; the raw settings behind each one
                // open only when asked for.
                VerticalLayout {
                    spacing: Theme.gap;
                    Heading { text: "What Squid can watch"; }

                    if root.sources.length == 0: Text {
                        text: "The session has not reported what it can watch yet.";
                        color: Theme.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    for source in root.sources: VerticalLayout {
                        spacing: Theme.gap-tight;

                        SourceCard {
                            source: source;
                            only-observer: source.state == "running" && root.running-sources <= 1;
                            expanded: root.open-group == source.label;
                            toggle(id, on) => { root.toggle-source(id, on); }
                            // Both doors lead to the same place. "Set it up" is
                            // the repair path and "Settings" is the curiosity
                            // path; there is no third, global one.
                            configure(id) => { root.select-group(source.label); }
                            open(id) => { root.select-group(source.label); }
                        }

                        // The capability's own settings, matched by the group the
                        // brain's schema assigned. Rust does the filtering: Slint
                        // cannot take a subset of a model, and the alternative —
                        // rendering every row and hiding the ones that do not
                        // match — leaves their layout space behind.
                        if root.open-group == source.label: VerticalLayout {
                            spacing: Theme.gap-tight;
                            padding-left: Theme.gap-loose;
                            for setting in root.group-settings: SettingEditor {
                                setting: setting;
                                save(id, value) => { root.save-setting(id, value); }
                            }
                        }
                    }
                }

                // Capture, with the consequence written out. Pause is the one
                // control that must never be hard to find.
                VerticalLayout {
                    spacing: Theme.gap;
                    Heading { text: "Recording"; }
                    Rectangle {
                        background: Theme.surface;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: Theme.pad;
                            spacing: Theme.gap;
                            Text {
                                text: root.gate == "paused"
                                    ? "Paused. Nothing new is being recorded."
                                    : (root.gate == "open"
                                        ? "Recording what happens on this machine."
                                        : "The session has not said whether it is recording. Pause control may not be set up — until it is, recording cannot be stopped from here.");
                                color: Theme.text;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.gap;
                                alignment: start;
                                // Exactly one action when the state is known.
                                // Both were offered when it was unknown, which
                                // asked the person to guess which one applied.
                                if root.gate == "open": Button {
                                    text: "Pause recording";
                                    accessible-description: "Stop recording new activity until you resume.";
                                    clicked => { root.pause(); }
                                }
                                if root.gate == "paused": Button {
                                    text: "Resume recording";
                                    accessible-description: "Start recording activity again.";
                                    clicked => { root.resume(); }
                                }
                                // Named for what it actually does. It used to say
                                // it would ask whether Squid is recording, and
                                // `refresh` cannot: it sends only `config_get`
                                // and `source_get`, and no V1 request makes the
                                // session re-send its world state. Re-reading the
                                // settings is still the useful move here, because
                                // pause control being configured is what would
                                // end this state — so the button keeps its place
                                // and drops the promise it could not keep.
                                if root.gate != "open" && root.gate != "paused": Button {
                                    text: "Re-read settings";
                                    accessible-description: "Ask the session for its settings and senses again.";
                                    clicked => { root.refresh(); }
                                }
                                if root.supervised && root.service-state == "failed": Button {
                                    text: "Start Squid again";
                                    accessible-description: "Restart the stopped session.";
                                    clicked => { root.start-service(); }
                                }
                                if root.supervised && root.service-state != "failed": Button {
                                    text: "Restart Squid";
                                    accessible-description: "Stop the session and start it again.";
                                    clicked => { root.restart-service(); }
                                }
                            }
                        }
                    }
                }

                // Evidence. Third, because it answers "what has it actually
                // seen" — the question that makes the rest of the panel
                // believable — but it is not what a person opens the window for.
                VerticalLayout {
                    spacing: Theme.gap;
                    Heading { text: "What Squid has seen"; }
                    Rectangle {
                        background: Theme.surface;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: Theme.pad;
                            spacing: Theme.gap-tight;
                            EvidenceRow { label: "In front of you"; value: root.application; }
                            EvidenceRow { label: "Window"; value: root.window-title; }
                            EvidenceRow { label: "Most recent"; value: root.last-event; }
                            EvidenceRow { label: "Recently"; value: root.recent-actions; }
                            EvidenceRow {
                                label: "Squid last said";
                                // Both known outcomes matched by name, and a
                                // token this build has not met reported as one.
                                // The else arm used to be "It replied", so an
                                // unknown status was announced as a successful
                                // turn — the optimistic direction, and the wrong
                                // one: `status` is carried as the string the
                                // brain sent precisely so this side never folds
                                // it onto a local enum.
                                value: root.agent-status == ""
                                    ? ""
                                    : (root.agent-status == "replied"
                                        ? "It replied"
                                        : root.agent-status == "failed"
                                            ? "It could not finish"
                                            : "It ended in a way this window does not know")
                                      + (root.agent-at == "" ? "" : " at " + root.agent-at);
                            }
                            if root.agent-text != "": Text {
                                text: root.agent-text;
                                color: Theme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                                max-height: 84px;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Settings that belong to no single sense: the model connection,
                // how long history is kept, which applications to stay out of.
                // Grouped by the brain's own group names, one door each.
                VerticalLayout {
                    spacing: Theme.gap;
                    Heading { text: "Squid itself"; }

                    if root.settings.length == 0: Text {
                        text: "The session has not reported its settings yet.";
                        color: Theme.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    // The last verdict from the session, wherever it came from.
                    // Kept beside the settings it usually concerns rather than
                    // at the very bottom of the window, which is where a refused
                    // source toggle used to report itself.
                    if root.status != "": Text {
                        text: root.status;
                        color: Theme.caution;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    for group in root.setting-groups: VerticalLayout {
                        spacing: Theme.gap-tight;
                        Rectangle {
                            background: Theme.surface;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: root.open-group == group ? Theme.focus : Theme.line;
                            HorizontalLayout {
                                padding: Theme.pad;
                                spacing: Theme.gap;
                                Text {
                                    text: group;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: root.open-group == group ? "Close" : "Open";
                                    accessible-description: (root.open-group == group ? "Hide" : "Show") + " the " + group + " settings.";
                                    clicked => { root.select-group(group); }
                                }
                            }
                        }
                        if root.open-group == group: VerticalLayout {
                            spacing: Theme.gap-tight;
                            padding-left: Theme.gap-loose;
                            for setting in root.group-settings: SettingEditor {
                                setting: setting;
                                save(id, value) => { root.save-setting(id, value); }
                            }
                        }
                    }
                }
            }
        }
    }
}
