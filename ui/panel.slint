import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SourceRow, SettingRow } from "model.slint";
import { StatusSummary } from "status.slint";
import { SourceCard } from "source-card.slint";
import { SettingEditor } from "settings.slint";
import { ConfirmationSection } from "confirmation.slint";

export { SourceRow, SettingRow }

component SectionTitle inherits Text { color: Theme.text; font-size: 15px; font-weight: 700; }
component EvidenceRow inherits HorizontalLayout {
    in property <string> label; in property <string> value; spacing: 12px;
    Text { text: root.label; color: Theme.text-muted; font-size: 12px; width: 104px; }
    Text { text: root.value == "" ? "Not observed" : root.value; color: Theme.text; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
}

export component PanelWindow inherits Window {
    in property <string> updated-at; in property <string> last-event; in property <string> application; in property <string> window-title; in property <string> gate;
    in property <int> selection-length: -1; in property <string> recent-actions; in property <int> episode-events: -1;
    in property <string> agent-status; in property <string> agent-text; in property <string> agent-at;
    callback pause(); callback resume();
    in property <string> agent-state; in property <bool> supervised; in property <string> service-state; in property <string> service-detail;
    callback restart-service(); callback start-service();
    in property <[SourceRow]> sources; callback toggle-source(string, bool);
    in property <[SettingRow]> settings; callback save-setting(string, string); callback refresh(); in property <string> status;
    in property <bool> prompt-pending; in property <string> prompt-kind; in property <string> prompt-summary; in property <string> prompt-expires-at;
    callback approve(); callback decline();

    title: "Squid"; always-on-top: false; preferred-width: 640px; preferred-height: 760px; min-width: 460px; background: Theme.canvas;
    VerticalLayout {
        padding: 20px; spacing: 18px;
        HorizontalLayout { Text { text: "Squid"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; } Button { text: "Refresh"; clicked => { root.refresh(); } } }
        StatusSummary { agent-state: root.agent-state; service-state: root.service-state; gate: root.gate; updated-at: root.updated-at; detail: root.service-detail; }
        ScrollView {
            horizontal-stretch: 1; vertical-stretch: 1;
            VerticalLayout {
                spacing: 18px;
                SectionTitle { text: "Recent activity"; }
                Rectangle { background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.line; VerticalLayout { padding: 14px; spacing: 8px;
                    EvidenceRow { label: "Application"; value: root.application; } EvidenceRow { label: "Window"; value: root.window-title; } EvidenceRow { label: "Last event"; value: root.last-event; } EvidenceRow { label: "Latest action"; value: root.recent-actions; }
                    EvidenceRow { label: "Agent"; value: root.agent-status == "" ? "No recent response" : root.agent-status + (root.agent-at == "" ? "" : " at " + root.agent-at); }
                    if root.agent-text != "": Text { text: root.agent-text; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; max-height: 72px; overflow: elide; }
                } }
                SectionTitle { text: "Capture"; }
                Rectangle { background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.line; VerticalLayout { padding: 14px; spacing: 8px;
                    Text { text: root.gate == "paused" ? "Capture is paused" : (root.gate == "open" ? "Capture is on" : "Capture state has not been reported"); color: Theme.text; font-size: 13px; font-weight: 600; }
                    HorizontalLayout { if root.gate != "paused": Button { text: "Pause capture"; clicked => { root.pause(); } } if root.gate != "open": Button { text: "Resume capture"; primary: true; clicked => { root.resume(); } } if root.supervised && root.service-state != "failed": Button { text: "Restart service"; clicked => { root.restart-service(); } } if root.supervised && root.service-state == "failed": Button { text: "Start service"; primary: true; clicked => { root.start-service(); } } }
                } }
                HorizontalLayout { SectionTitle { text: "Sources"; horizontal-stretch: 1; } Text { text: "Choose what Squid can observe"; color: Theme.text-muted; font-size: 11px; } }
                if root.sources.length == 0: Text { text: "Sources will appear when the session reports its catalog."; color: Theme.text-muted; font-size: 12px; }
                for source in root.sources: SourceCard { source: source; toggle(id, enabled) => { root.toggle-source(id, enabled); } }
                SectionTitle { text: "Configuration and technical details"; }
                Rectangle { background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.line; VerticalLayout { padding: 14px; spacing: 10px;
                    Text { text: root.agent-state == "needs_config" ? "Add the model connection details to enable responses." : "Connection settings and service details stay here when you need them."; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                    if root.status != "": Text { text: root.status; color: Theme.warning; font-size: 11px; wrap: word-wrap; }
                    if root.settings.length == 0: Text { text: "No settings have been reported yet."; color: Theme.text-muted; font-size: 12px; }
                    for setting in root.settings: SettingEditor { setting: setting; save(id, value) => { root.save-setting(id, value); } }
                } }
                ConfirmationSection { pending: root.prompt-pending; kind: root.prompt-kind; summary: root.prompt-summary; expires-at: root.prompt-expires-at; approve => { root.approve(); } decline => { root.decline(); } }
            }
        }
    }
}
