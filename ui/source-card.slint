import { Button, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SourceRow } from "model.slint";

// One sense, as a card that is both its own status and its own way in.
//
// The old panel split these: a checkbox in SOURCES said `unsupported`, and the
// two settings that would fix it sat in a form two sections below, under names
// like `SQUID_BROWSER`. The symptom and the cure were never in the same place,
// and nothing on screen connected them. Here the card that reports the problem
// carries the button that opens it — which is also why the panel needs no
// global "Advanced" page: depth is reached through the thing you were already
// looking at.
export component SourceCard inherits Rectangle {
    in property <SourceRow> source;
    // True when this is the only observer still running. The session refuses to
    // stop the last one, so the card explains that before a click can fail
    // rather than after — a refusal delivered two sections away, in the shared
    // status line, was the old shape.
    in property <bool> only-observer;
    in property <bool> expanded;

    callback toggle(string, bool);
    callback configure(string);
    callback open(string);

    // Whether the catalog row says something this build can read.
    //
    // `state` is a free string the whole way here: the parser takes whatever the
    // brain sent (`ui/src/protocol.rs`) and Rust copies it through untouched
    // (`ui/src/main.rs`), which is the same deliberate refusal to flatten a
    // brain's word onto a local enum that `agentState` gets. So a token this
    // build has never met is a line the wire can really deliver, and it used to
    // land in one `else` arm that answered it with "Off": a muted line, an
    // unchecked switch, and — because `repairable` was false — an enabled one.
    // Together those said the person had switched this capability off
    // themselves, a claim nothing on the wire made.
    //
    // An unread token therefore gets the words and nothing else. No switch, and
    // no offer to repair it either: `repairable` stays an exact match on
    // `unsupported`, because "I cannot read this" is not a promise that a
    // setting would fix it. The settings door is the one thing that stays, since
    // a door makes no claim about what is behind it. It is quiet rather than
    // alarming — the tint below stays a three-way choice — because a token this
    // panel has not met is a gap in what it can say, not a fault it has found.
    // Do not fold any of this back into a default arm, and do not restore the
    // switch on the grounds that a disabled one looks harmless: an unchecked
    // switch says off.
    out property <bool> state-known:
        root.source.state == "running"
        || root.source.state == "stopped"
        || root.source.state == "unsupported";

    // Plain language, never the wire's own word. `running`, `stopped`, and
    // `unsupported` are protocol tokens; a person reads none of them. The fourth
    // reading names the gap instead of guessing which of the three it is nearest.
    out property <string> state-text:
        root.source.state == "running" ? "Watching"
        : root.source.state == "unsupported" ? "Not set up"
        : root.source.state == "stopped" ? "Off"
        : "Not recognised";

    out property <brush> state-tint:
        root.source.state == "running" ? Theme.calm
        : root.source.state == "unsupported" ? Theme.caution
        : Theme.text-muted;

    // `unsupported` means this run cannot start the capability — and for the
    // three optional senses that is almost always an absent setting rather than
    // an absent machine. So the card offers to open its own settings instead of
    // reporting a dead end.
    out property <bool> repairable: root.source.state == "unsupported";

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.expanded ? Theme.focus : Theme.line;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap-tight;

        HorizontalLayout {
            spacing: Theme.gap;

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.source.label;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }
                Text {
                    text: root.state-text;
                    color: root.state-tint;
                    font-size: 12px;
                }
            }

            // A switch, not a checkbox: this starts and stops a process that
            // watches the machine, which is a setting rather than a selection.
            // Disabled only when there is genuinely nothing to toggle; the
            // last-observer case stays enabled so the explanation below is what
            // the person reads, not a control that silently does nothing.
            //
            // Absent, not disabled, for a state this build cannot read. A switch
            // has two positions and both of them are assertions: unchecked says
            // the capability is off, and greying that out only adds that the
            // person may not change it. There is no third position for "unread",
            // so the honest control is no control, with the sentence below in
            // its place.
            if root.state-known: Switch {
                checked: root.source.state == "running";
                enabled: !root.repairable && !root.only-observer;
                accessible-label: root.source.label;
                accessible-description: root.source.label + " is " + root.state-text;
                toggled => { root.toggle(root.source.id, self.checked); }
            }
        }

        // The missing switch, explained. A card whose status nobody can read and
        // whose control quietly vanished is its own small mystery, and the reason
        // is worth more to a person than the switch was.
        if !root.state-known: Text {
            text: "The session described this sense in words this window does not know, so nothing here can say whether it is on. This window may be older than the session it is watching.";
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        // "Watching" told half the truth. A sense can be running and still blind:
        // a screen reader without its accessibility permission keeps polling and
        // keeps being refused, and its newest diagnostic is the one sentence a
        // person can act on. The brain records it on stderr — where the person
        // who double-clicked this panel reads nothing — so it travels with the
        // catalog row instead, and the card that says "Watching" carries the
        // sentence that qualifies it. Caution because the row is a complaint,
        // not a status; the switch stays on because the sense *is* running.
        if root.source.state == "running" && root.source.detail != "": Text {
            text: root.source.detail;
            color: Theme.caution;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.only-observer && root.source.state == "running": Text {
            text: "This is the only thing Squid is watching. Turn on another before switching this one off.";
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.repairable: HorizontalLayout {
            spacing: Theme.gap;
            Text {
                text: "Squid cannot start this yet. It needs a setting first.";
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Set it up";
                accessible-description: "Open the settings that " + root.source.label + " needs.";
                clicked => { root.configure(root.source.id); }
            }
        }

        // The local escape hatch. Not a global technical mode: the raw values
        // for this one capability, reachable from this one capability, and
        // closed again by the same control.
        if !root.repairable: HorizontalLayout {
            alignment: start;
            Button {
                text: root.expanded ? "Hide settings" : "Settings";
                accessible-description: (root.expanded ? "Hide" : "Show") + " the settings for " + root.source.label;
                clicked => { root.open(root.source.id); }
            }
        }
    }
}
