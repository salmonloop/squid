import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SettingRow } from "model.slint";

export component SettingEditor inherits Rectangle {
    in property <SettingRow> setting;
    callback save(string, string);
    background: Theme.surface-muted; border-radius: 6px;
    VerticalLayout {
        padding: 10px; spacing: 6px;
        HorizontalLayout {
            Text { text: root.setting.label; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-stretch: 1; }
            if root.setting.overridden: Text { text: "Environment override"; color: Theme.warning; font-size: 10px; }
            if root.setting.applies == "restart": Text { text: "Restart required"; color: Theme.warning; font-size: 10px; }
        }
        HorizontalLayout {
            editor := LineEdit { text: root.setting.value; placeholder-text: root.setting.kind == "secret" ? "Write-only value" : ""; input-type: root.setting.kind == "secret" ? InputType.password : InputType.text; horizontal-stretch: 1; accepted(value) => { root.save(root.setting.id, value); } }
            Button { text: "Save"; clicked => { root.save(root.setting.id, editor.text); } }
        }
        if root.setting.values != "": Text { text: "Allowed values: " + root.setting.values; color: Theme.text-muted; font-size: 10px; wrap: word-wrap; }
    }
}
