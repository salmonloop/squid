import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SettingRow } from "model.slint";

// A small trailing marker beside a settings row.
component Marker inherits Rectangle {
    in property <string> text;
    in property <brush> tint;

    background: Theme.surface-sunken;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 11px;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

// Tooltip card with rich guidance and realistic examples shown when hovering over the help icon.
component HelpTooltip inherits Rectangle {
    in property <string> setting-id;
    in property <string> description;

    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.focus;

    VerticalLayout {
        padding: Theme.gap;
        spacing: 4px;

        if root.setting-id == "modelBaseUrl": VerticalLayout {
            spacing: 2px;
            Text { text: "Base URL Examples & Configuration:"; font-weight: 700; color: Theme.focus; font-size: 11px; wrap: word-wrap; }
            Text { text: "• OpenAI / Proxy: https://api.openai.com/v1"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• DeepSeek: https://api.deepseek.com/v1"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• OpenRouter: https://openrouter.ai/api/v1"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Ollama (Local): http://localhost:11434/v1"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• LM Studio: http://localhost:1234/v1"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Default Gateway: http://127.0.0.1:8000/v1"; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
        }

        if root.setting-id == "modelId": VerticalLayout {
            spacing: 2px;
            Text { text: "Model ID Examples:"; font-weight: 700; color: Theme.focus; font-size: 11px; wrap: word-wrap; }
            Text { text: "• OpenAI: gpt-4o, gpt-4o-mini, o1-mini"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• DeepSeek: deepseek-chat, deepseek-coder"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Anthropic (via proxy): claude-3-5-sonnet-20241022"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Ollama: llama3.1, qwen2.5-coder"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
        }

        if root.setting-id == "apiKey": VerticalLayout {
            spacing: 2px;
            Text { text: "API Key Examples & Notice:"; font-weight: 700; color: Theme.focus; font-size: 11px; wrap: word-wrap; }
            Text { text: "• OpenAI: sk-proj-..."; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• DeepSeek: sk-..."; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• OpenRouter: sk-or-v1-..."; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Local / Ollama: leave empty or any dummy string"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Plaintext: Displayed in plaintext without masking for fast development."; color: Theme.caution; font-size: 11px; wrap: word-wrap; }
        }

        if root.setting-id == "modelProvider": VerticalLayout {
            spacing: 2px;
            Text { text: "Model Provider (Profile Key/Slug):"; font-weight: 700; color: Theme.focus; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Examples: openai, deepseek, openrouter, anthropic, ollama"; color: Theme.text; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Key indexing your credentials in models.json & auth.json."; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
            Text { text: "• Changing this switches Squid to that provider profile immediately."; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
        }

        if root.setting-id != "modelBaseUrl" && root.setting-id != "modelId" && root.setting-id != "apiKey" && root.setting-id != "modelProvider": VerticalLayout {
            spacing: 2px;
            Text { text: "Information:"; font-weight: 700; color: Theme.focus; font-size: 11px; wrap: word-wrap; }
            Text { text: root.description; color: Theme.text; font-size: 11px; wrap: word-wrap; }
        }
    }
}

// One setting, named for what it does rather than for the variable behind it.
export component SettingEditor inherits Rectangle {
    in property <SettingRow> setting;
    callback save(string, string);

    background: Theme.surface-sunken;
    border-radius: 6px;

    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap-tight;

        HorizontalLayout {
            spacing: Theme.gap-tight;

            Text {
                text: root.setting.label;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            // Interactive Help / Tooltip Icon
            help-icon := Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: help-touch.has-hover ? Theme.focus : Theme.surface;
                border-width: 1px;
                border-color: help-touch.has-hover ? Theme.focus : Theme.line;

                Text {
                    text: "?";
                    font-size: 10px;
                    font-weight: 700;
                    color: help-touch.has-hover ? Theme.surface : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                help-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.setting.overridden: Marker {
                text: "set elsewhere";
                tint: Theme.caution;
            }
            if root.setting.applies == "restart": Marker {
                text: "needs restart";
                tint: Theme.caution;
            }
        }

        // Expanded hover card when hovering over the help icon
        if help-touch.has-hover: HelpTooltip {
            setting-id: root.setting.id;
            description: root.setting.description;
        }

        // Setting description in one sentence
        if !help-touch.has-hover && root.setting.description != "": Text {
            text: root.setting.description;
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.gap-tight;

            editor := LineEdit {
                text: root.setting.value;
                // For MVP development efficiency, all settings are displayed in plaintext with clear examples.
                placeholder-text: root.setting.id == "modelBaseUrl" ? "https://api.openai.com/v1"
                    : root.setting.id == "modelId" ? "gpt-4o"
                    : root.setting.id == "apiKey" ? "sk-..."
                    : root.setting.id == "modelProvider" ? "openai"
                    : "";
                input-type: InputType.text;
                horizontal-stretch: 1;
                accessible-label: root.setting.label;
                accessible-description: root.setting.description;
                accepted(value) => { root.save(root.setting.id, value); }
            }
            Button {
                text: "Save";
                enabled: editor.text != root.setting.value;
                accessible-description: "Save " + root.setting.label;
                clicked => { root.save(root.setting.id, editor.text); }
            }
        }

        // Compact realistic examples line directly below input
        if root.setting.id == "modelBaseUrl": Text {
            text: "Examples: OpenAI: https://api.openai.com/v1 | DeepSeek: https://api.deepseek.com/v1 | Ollama: http://localhost:11434/v1";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        if root.setting.id == "modelId": Text {
            text: "Examples: OpenAI: gpt-4o | DeepSeek: deepseek-chat | Anthropic: claude-3-5-sonnet | Ollama: llama3.1";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        if root.setting.id == "apiKey": Text {
            text: "Examples: OpenAI: sk-proj-... | DeepSeek: sk-... | Local/Ollama: leave empty (stored in plaintext)";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        if root.setting.id == "modelProvider": Text {
            text: "Examples: openai | deepseek | openrouter | anthropic | ollama (provider profile key in models.json)";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        if root.setting.values != "": Text {
            text: "Choose one of: " + root.setting.values;
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
