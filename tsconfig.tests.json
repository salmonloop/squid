{
  // The build config compiles `src` into `dist`, so it deliberately excludes the
  // tests — but excluding them from `tsc` altogether meant nothing ever checked
  // them, and a test asserting against a type that no longer existed still
  // passed the gate. This config type-checks the suites against the real source
  // types without emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
